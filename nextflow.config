manifest {
    name            = 'sagflow'
    author          = 'SAGFlow contributors'
    description     = 'Reproducible single-amplified genome analysis'
    mainScript      = 'main.nf'
    nextflowVersion = '>=25.04.0'
    version         = '0.1.0'
}

params {
    input                    = null
    outdir                   = null
    reference_panel          = null
    skip_fastqc              = false
    skip_competitive_mapping = false
    skip_assembly            = false
    skip_checkm2             = true
    skip_gunc                = true
    skip_gtdbtk              = true
    skip_multiqc             = false
    checkm2_db               = null
    gunc_db                  = null
    gtdbtk_data_path         = null
    min_mapq                 = 20
    max_cpus                 = 32
    max_memory               = '128.GB'
    max_time                 = '7.d'
}

process {
    executor = 'local'
    errorStrategy = { task.exitStatus in [137, 143] ? 'retry' : 'terminate' }
    maxRetries = 1

    withLabel: process_low {
        cpus = 2
        memory = 4.GB
        time = 2.h
    }
    withLabel: process_medium {
        cpus = 8
        memory = 24.GB
        time = 12.h
    }
    withLabel: process_high {
        cpus = 16
        memory = 64.GB
        time = 3.d
    }
}

profiles {
    standard {
        process.executor = 'local'
    }

    conda {
        conda.enabled = true
        conda.useMamba = false
    }

    docker {
        docker.enabled = true
        docker.runOptions = '--user $(id -u):$(id -g)'
    }

    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
    }

    test {
        params.input = "${projectDir}/tests/data/samplesheet.csv"
        params.outdir = "${projectDir}/test-output/stub"
        params.reference_panel = "${projectDir}/tests/data/reference.fa"
        params.skip_checkm2 = true
        params.skip_gunc = true
        params.skip_gtdbtk = true
        process.cpus = 1
        process.memory = 1.GB
        process.time = 10.m
    }
}

timeline {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_timeline.html"
    overwrite = false
}
report {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_report.html"
    overwrite = false
}
trace {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_trace.txt"
    overwrite = false
}
dag {
    enabled = true
    file = "${params.outdir}/pipeline_info/pipeline_dag.html"
    overwrite = false
}

cleanup = false
